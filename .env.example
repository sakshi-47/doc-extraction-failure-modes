# Copy to .env and fill in. .env is gitignored and must never be committed.

# LLM provider for the VLM extractor baseline (optional for metric-only work)
ANTHROPIC_API_KEY=

# Where datasets are downloaded to
DOCFAIL_DATA_DIR=./data
DOCFAIL_CACHE_DIR=./cache
DOCFAIL_OUTPUT_DIR=./outputs

# Silent-failure classification thresholds
DOCFAIL_CONFIDENCE_THRESHOLD=0.7
